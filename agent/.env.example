# ==============================================================================
# LINGUALOOP ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER & NETWORK SETTINGS
# ------------------------------------------------------------------------------
# Runtime environment mode: 'development', 'production', or 'test'
NODE_ENV=development

# HTTP server and WebSocket gateway port number (Default: 5000)
PORT=5000

# ------------------------------------------------------------------------------
# DATABASE & CACHE SETTINGS
# ------------------------------------------------------------------------------
# MongoDB connection URL string (Required)
# Example local: mongodb://localhost:27017
# Example Atlas: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_URI=mongodb://localhost:27017

# MongoDB target database name (Default: lingualoop_db)
MONGODB_DB_NAME=lingualoop_db

# Redis connection URL for tracking real-time voice call sessions (Default: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT tokens (Required, minimum 10 characters)
JWT_SECRET=super_secret_jwt_key_lingualoop_2026_auth

# JWT token expiration timeframe (Default: 24h)
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# AI MODEL & AGENT SETTINGS (OLLAMA & MASTRA)
# ------------------------------------------------------------------------------
# Base URL endpoint for local Ollama service running qwen2.5:1.5b (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Local database file path or URL for Mastra storage (Default: file:./mastra.db)
MASTRA_STORAGE_URL=file:./mastra.db

# ------------------------------------------------------------------------------
# MASTRA CLOUD PLATFORM SETTINGS (OPTIONAL)
# ------------------------------------------------------------------------------
# Access token for Mastra Cloud platform integration
MASTRA_PLATFORM_ACCESS_TOKEN=

# Mastra Cloud project ID
MASTRA_PROJECT_ID=
